# Retains the hardened TEN-609 Node base, non-root user, and production audit.
ARG NODE_IMAGE=docker.io/library/node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43
FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json vitest.config.ts vitest.setup.ts ./
COPY web ./web
COPY src ./src
COPY scripts ./scripts
COPY examples ./examples
COPY migrations ./migrations
RUN npm ci --ignore-scripts
RUN npm run generate:registry && npm test
RUN npm run generate:catalog && npm run build && npm run build --workspace web

FROM ${NODE_IMAGE}
ARG VCS_REF
ARG BUILD_DATE
LABEL org.opencontainers.image.source="https://github.com/agent-os-inc/open-connector" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="1.3.4-agentos-tenant-files" \
      org.opencontainers.image.licenses="Apache-2.0" \
      agentos.openconnector.base-tree="73bf9fedb4b46191a883ed8cd959c49bab0dd50d"
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOST=0.0.0.0 OOMOL_CONNECT_DATA_DIR=/app/data OOMOL_CONNECT_TRANSIT_FILE_BACKEND=s3
COPY --from=build /app/package.json /app/package-lock.json ./
COPY scripts/healthcheck.ts scripts/ensure-generated.ts ./scripts/
COPY migrations ./migrations
COPY LICENSE.txt NOTICE.md /licenses/openconnector/
COPY --from=build /app/src ./src
COPY --from=build /app/catalog ./catalog
COPY --from=build /app/dist ./dist
RUN npm ci --omit=dev --ignore-scripts \
    && npm audit --omit=dev --audit-level=high \
    && addgroup -S -g 10001 openconnector \
    && adduser -S -D -H -u 10001 -G openconnector openconnector \
    && mkdir -p /app/data \
    && chown -R 10001:10001 /app /licenses/openconnector
USER 10001:10001
VOLUME ["/app/data"]
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD ["node", "scripts/healthcheck.ts"]
CMD ["node", "src/server/index.ts"]
